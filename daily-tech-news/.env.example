# =============================================================
# .env.example — Copy this file to .env and fill in your values
# NEVER commit .env to GitHub
# =============================================================

# --- News API ---
# Get your free API key from: https://newsdata.io (instant access, no email wait)
# Key format: pub_XXXXXXXXXXXXXXXXXXXXXXXX
NEWS_API_KEY=your_newsdata_key_here

# --- MongoDB ---
# Default local MongoDB connection (no username/password needed for local)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tech_news

# --- Flask ---
FLASK_PORT=5000
FLASK_DEBUG=True

# --- Scheduler ---
# Run the daily job at 6:00 AM every day
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
